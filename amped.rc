#include <windows.h>
#include "resource.h"

// .ico files are produced by make_icons.ps1; build.bat / CMakeLists.txt
// invoke it before compiling this .rc, so the files are guaranteed to
// exist by the time rc.exe parses these lines.
IDI_FULL  ICON "full.ico"
IDI_EMPTY ICON "empty.ico"

// Application manifest: enables Common Controls v6 and per-monitor DPI.
1 RT_MANIFEST "amped.manifest"
